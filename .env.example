# PostgreSQL connection (local Docker: docker compose up -d)
DATABASE_URL=postgresql://athlink:athlink@localhost:5432/athlink

# Session cookie signing secret (generate: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Public app URL (used for absolute links in emails/calendar later)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: protect GET /api/stats with X-Admin-Token header
ADMIN_STATS_TOKEN=

# Executive admin (/admin) — leadership only
# Generate bootstrap secret: openssl rand -hex 32
ADMIN_BOOTSTRAP_SECRET=
EXECUTIVE_EMAIL_DOMAINS=athlink.com,athlink.app

# Clerk authentication (https://dashboard.clerk.com)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Planned admin integrations (optional in MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
SENTRY_DSN=
SLACK_ALERT_WEBHOOK=
JOTFORM_API_KEY=
